{
  "expo": {
    "name": "Claude Term",
    "slug": "claude-term-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "nl.mendrix.claudeterm.companion",
      "appleTeamId": "A42SG7SSPP",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "nl.mendrix.claudeterm.companion",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing code shown on your Mac."
        }
      ]
    ],
    "scheme": "claude-term",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f72ff1d6-3359-4022-84c5-9bae92bc8b16"
      }
    },
    "owner": "robcvdv"
  }
}
